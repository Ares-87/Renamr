<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="Renamr.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Nessun RequestedTheme: l'app segue automaticamente il tema chiaro/scuro di Windows. -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Logo e scritta: navy sul tema chiaro, bianco sul tema scuro. Sorgenti vettoriali in assets/brand. -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <BitmapImage x:Key="RenamrLogo" UriSource="ms-appx:///Assets/logo-light.png" />
                    <BitmapImage x:Key="RenamrWordmark" UriSource="ms-appx:///Assets/wordmark-light.png" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Default">
                    <BitmapImage x:Key="RenamrLogo" UriSource="ms-appx:///Assets/logo-dark.png" />
                    <BitmapImage x:Key="RenamrWordmark" UriSource="ms-appx:///Assets/wordmark-dark.png" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <BitmapImage x:Key="RenamrLogo" UriSource="ms-appx:///Assets/logo-dark.png" />
                    <BitmapImage x:Key="RenamrWordmark" UriSource="ms-appx:///Assets/wordmark-dark.png" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!-- Badge di stato a "pillola" -->
            <Style x:Key="StatusBadgeStyle" TargetType="Border">
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Padding" Value="10,2,10,3" />
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="StatusBadgeTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>

            <!-- Schede delle regole nella modalità "Rinomina file" -->
            <Style x:Key="RuleCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="12,8,8,12" />
            </Style>

            <Style x:Key="RuleIconButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Padding" Value="6" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
            </Style>

            <!-- Numero di versione accanto al logo -->
            <Style x:Key="VersionPillStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="7,1,7,2" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="ColumnHeaderTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
