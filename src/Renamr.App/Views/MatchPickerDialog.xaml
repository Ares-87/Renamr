<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="Renamr.App.Views.MatchPickerDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:Renamr.Core.Localization"
    xmlns:vm="using:Renamr.Presentation.ViewModels"
    Title="{x:Bind loc:Strings.Current.MatchPickerTitle}"
    PrimaryButtonText="{x:Bind loc:Strings.Current.MatchPickerUse}"
    CloseButtonText="{x:Bind loc:Strings.Current.Cancel}"
    DefaultButton="Primary"
    IsPrimaryButtonEnabled="{x:Bind ViewModel.CanApply, Mode=OneWay}"
    Style="{StaticResource DefaultContentDialogStyle}">

    <!-- Stessi campi di Renamr.Linux/Views/MatchPickerDialog.axaml. -->
    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">720</x:Double>
        <Style x:Key="HintTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </ContentDialog.Resources>

    <StackPanel Spacing="12" Width="600">
        <!-- Il file di cui si sceglie la corrispondenza -->
        <TextBlock Text="{x:Bind ViewModel.FileName}" Style="{StaticResource HintTextStyle}"
                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                   ToolTipService.ToolTip="{x:Bind ViewModel.FileName}" />

        <!-- Risultati già trovati (anche quelli scartati perché incerti) o della ricerca qui sotto -->
        <TextBlock Text="{x:Bind loc:Strings.Current.MatchPickerResults}" Style="{StaticResource BodyStrongTextBlockStyle}" />
        <ListView x:Name="ChoiceList" Height="260"
                  ItemsSource="{x:Bind ViewModel.Choices}"
                  SelectedItem="{x:Bind ViewModel.SelectedChoice, Mode=TwoWay}"
                  SelectionMode="Single"
                  DoubleTapped="ChoiceList_DoubleTapped"
                  Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                  BorderThickness="1" CornerRadius="8" Padding="0,4">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:MatchChoiceViewModel">
                    <StackPanel Padding="0,6" Spacing="1" ToolTipService.ToolTip="{x:Bind Overview}">
                        <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{x:Bind Subtitle}" Visibility="{x:Bind HasSubtitle}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{x:Bind Details}" Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <StackPanel Orientation="Horizontal" Spacing="8">
            <ProgressRing Width="16" Height="16" IsActive="{x:Bind ViewModel.IsSearching, Mode=OneWay}"
                          Visibility="{x:Bind ViewModel.IsSearching, Mode=OneWay}" />
            <TextBlock Text="{x:Bind ViewModel.Message, Mode=OneWay}" Style="{StaticResource HintTextStyle}" />
        </StackPanel>

        <!-- Ricerca personalizzata: titolo, anno, tipo e, per le serie, stagione ed episodio -->
        <TextBlock Text="{x:Bind loc:Strings.Current.MatchPickerSearchTitle}" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,4,0,0" />
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="80" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="QueryBox" Header="{x:Bind loc:Strings.Current.MatchPickerQuery}"
                     Text="{x:Bind ViewModel.Query, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     KeyDown="QueryBox_KeyDown" KeyUp="QueryBox_KeyUp" />
            <TextBox Grid.Column="1" Header="{x:Bind loc:Strings.Current.MatchPickerYear}"
                     Text="{x:Bind ViewModel.Year, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <ComboBox Grid.Column="2" MinWidth="170" Header="{x:Bind loc:Strings.Current.MatchPickerKind}"
                      ItemsSource="{x:Bind ViewModel.Kinds}"
                      SelectedIndex="{x:Bind ViewModel.KindIndex, Mode=TwoWay}" />
        </Grid>
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Width="80" Header="{x:Bind loc:Strings.Current.MatchPickerSeason}"
                     Text="{x:Bind ViewModel.Season, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     Visibility="{x:Bind ViewModel.IsSeries, Mode=OneWay}" />
            <TextBox Grid.Column="1" Width="80" Header="{x:Bind loc:Strings.Current.MatchPickerEpisode}"
                     Text="{x:Bind ViewModel.Episode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     Visibility="{x:Bind ViewModel.IsSeries, Mode=OneWay}" />
            <Button Grid.Column="3" VerticalAlignment="Bottom" Style="{StaticResource AccentButtonStyle}"
                    Command="{x:Bind ViewModel.SearchCommand}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE721;" FontSize="14" />
                    <TextBlock Text="{x:Bind loc:Strings.Current.MatchPickerSearch}" />
                </StackPanel>
            </Button>
        </Grid>
    </StackPanel>
</ContentDialog>
