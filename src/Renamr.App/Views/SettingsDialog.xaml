<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="Renamr.App.Views.SettingsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Impostazioni"
    PrimaryButtonText="Salva"
    CloseButtonText="Annulla"
    DefaultButton="Primary"
    PrimaryButtonCommand="{x:Bind ViewModel.SaveCommand}"
    Style="{StaticResource DefaultContentDialogStyle}">

    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">720</x:Double>
        <Style x:Key="PreviewTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="Margin" Value="2,4,0,0" />
            <Setter Property="IsTextSelectionEnabled" Value="True" />
        </Style>
    </ContentDialog.Resources>

    <ScrollViewer MaxHeight="560" Padding="0,0,16,0">
        <StackPanel Spacing="20" MinWidth="560">

            <!-- Template con anteprima dal vivo -->
            <StackPanel Spacing="10">
                <TextBlock Text="Formato dei nomi" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <TextBlock TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Text="Segnaposto: {Title} {Year} {Resolution} {Show Title} {Season:00} {Episode:00} {Episode Title} {Absolute:000} {Artist} {Album} {Track:00}. Usa / per organizzare in cartelle." />

                <StackPanel>
                    <TextBox Header="Film" Text="{x:Bind ViewModel.MovieTemplate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="{x:Bind ViewModel.MoviePreview, Mode=OneWay}" Style="{StaticResource PreviewTextStyle}" />
                </StackPanel>
                <StackPanel>
                    <TextBox Header="Serie TV" Text="{x:Bind ViewModel.EpisodeTemplate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="{x:Bind ViewModel.EpisodePreview, Mode=OneWay}" Style="{StaticResource PreviewTextStyle}" />
                </StackPanel>
                <StackPanel>
                    <TextBox Header="Anime (numerazione assoluta)" Text="{x:Bind ViewModel.AnimeTemplate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="{x:Bind ViewModel.AnimePreview, Mode=OneWay}" Style="{StaticResource PreviewTextStyle}" />
                </StackPanel>
                <StackPanel>
                    <TextBox Header="Musica" Text="{x:Bind ViewModel.MusicTemplate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="{x:Bind ViewModel.MusicPreview, Mode=OneWay}" Style="{StaticResource PreviewTextStyle}" />
                </StackPanel>
                <HyperlinkButton Content="Ripristina formati predefiniti" Command="{x:Bind ViewModel.RestoreDefaultTemplatesCommand}" Padding="0" />
            </StackPanel>

            <!-- Database online -->
            <StackPanel Spacing="10">
                <TextBlock Text="Database online" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <TextBlock TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Text="Le chiavi sono cifrate con il tuo account Windows. TVmaze e MusicBrainz funzionano senza chiave; i provider senza chiave vengono saltati." />
                <PasswordBox Header="TheMovieDB (API key v3)" Password="{x:Bind ViewModel.TmdbApiKey, Mode=TwoWay}" />
                <PasswordBox Header="OMDb (API key)" Password="{x:Bind ViewModel.OmdbApiKey, Mode=TwoWay}" />
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <PasswordBox Header="TheTVDB (API key v4)" Password="{x:Bind ViewModel.TheTvdbApiKey, Mode=TwoWay}" />
                    <PasswordBox Grid.Column="1" Header="PIN abbonato (opz.)" Password="{x:Bind ViewModel.TheTvdbPin, Mode=TwoWay}" />
                </Grid>
                <PasswordBox Header="AcoustID (client key)" Password="{x:Bind ViewModel.AcoustIdClientKey, Mode=TwoWay}" />
                <TextBox Header="AniDB (nome client registrato)" Text="{x:Bind ViewModel.AniDbClientName, Mode=TwoWay}" />
            </StackPanel>

            <!-- Riconoscimento -->
            <StackPanel Spacing="10">
                <TextBlock Text="Riconoscimento" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <Slider Header="Confidenza minima per lo stato &quot;Pronto&quot; (%)"
                        Minimum="50" Maximum="99" StepFrequency="1" TickFrequency="5" TickPlacement="Outside"
                        Value="{x:Bind ViewModel.HighConfidencePercent, Mode=TwoWay}" />
                <ComboBox Header="Lingua dei titoli"
                          ItemsSource="{x:Bind ViewModel.Languages}"
                          SelectedItem="{x:Bind ViewModel.Language, Mode=TwoWay}"
                          MinWidth="200" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
