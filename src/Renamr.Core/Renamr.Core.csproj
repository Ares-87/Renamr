<Project Sdk="Microsoft.NET.Sdk">
  <!-- Layer di dominio puro: nessuna dipendenza da UI, I/O o rete. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Renamr.Core</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <!-- Testi dell'interfaccia: un file per lingua, letti da Localization/Strings.cs. -->
    <EmbeddedResource Include="Localization\*.json" LogicalName="Renamr.Core.Localization.%(Filename).json" />
  </ItemGroup>
</Project>
