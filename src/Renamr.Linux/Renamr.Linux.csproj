<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Shell Linux (Avalonia + FluentAvalonia). Stesso ruolo di Renamr.App su Windows: solo Views e servizi di piattaforma
    (selettore cartelle, chiavi cifrate, file manager). La logica sta in Renamr.Presentation / Services / Core.
    Build e avvio:  dotnet run (dalla cartella src/Renamr.Linux)
    Pacchetto autonomo: dotnet publish -c Release -r linux-x64 (oppure linux-arm64)
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Renamr.Linux</RootNamespace>
    <AssemblyName>Renamr</AssemblyName>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <SelfContained Condition="'$(RuntimeIdentifier)' != ''">true</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="FluentAvaloniaUI" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
  </ItemGroup>

  <ItemGroup>
    <!-- Logo (chiaro e scuro) e icona della finestra: sorgenti vettoriali in assets/brand. -->
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Renamr.Core\Renamr.Core.csproj" />
    <ProjectReference Include="..\Renamr.Services\Renamr.Services.csproj" />
    <ProjectReference Include="..\Renamr.Presentation\Renamr.Presentation.csproj" />
  </ItemGroup>
</Project>
