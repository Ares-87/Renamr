<ctl:FAContentDialog xmlns="https://github.com/avaloniaui"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:l="using:Renamr.Linux.Helpers"
                     xmlns:ctl="using:FluentAvalonia.UI.Controls"
                     xmlns:vm="using:Renamr.Presentation.ViewModels"
                     x:Class="Renamr.Linux.Views.SettingsDialog"
                     x:DataType="vm:SettingsViewModel"
                     Title="{l:Tr Settings}"
                     PrimaryButtonText="{l:Tr Save}"
                     CloseButtonText="{l:Tr Cancel}"
                     DefaultButton="Primary"
                     PrimaryButtonCommand="{Binding SaveCommand}">

    <!-- Stessi campi di Renamr.App/Views/SettingsDialog.xaml. -->
    <ctl:FAContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">720</x:Double>
    </ctl:FAContentDialog.Resources>

    <ctl:FAContentDialog.Styles>
        <Style Selector="TextBlock.preview">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="Margin" Value="2,4,0,0" />
        </Style>
        <Style Selector="TextBlock.hint">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style Selector="TextBlock.label">
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
    </ctl:FAContentDialog.Styles>

    <ScrollViewer MaxHeight="560" Padding="0,0,16,0">
        <StackPanel Spacing="20" MinWidth="560" MaxWidth="680">

            <!-- In "Rinomina file" formati, chiavi API e riconoscimento non servono: si vedono solo in "Film, Serie e Musica". -->
            <TextBlock Classes="hint" Text="{l:Tr SettingsBatchHint}" IsVisible="{Binding IsBatchMode}" />

            <!-- Template con anteprima dal vivo -->
            <StackPanel Spacing="10" IsVisible="{Binding IsMediaMode}">
                <TextBlock Text="{l:Tr SettingsNameFormats}" Theme="{StaticResource BodyStrongTextBlockStyle}" />
                <TextBlock Classes="hint"
                           Text="{l:Tr SettingsPlaceholders}" />

                <StackPanel>
                    <TextBlock Classes="label" Text="{l:Tr FormatMovie}" />
                    <TextBox Text="{Binding MovieTemplate}" />
                    <TextBlock Classes="preview" Text="{Binding MoviePreview}" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Classes="label" Text="{l:Tr FormatEpisode}" />
                    <TextBox Text="{Binding EpisodeTemplate}" />
                    <TextBlock Classes="preview" Text="{Binding EpisodePreview}" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Classes="label" Text="{l:Tr FormatAnime}" />
                    <TextBox Text="{Binding AnimeTemplate}" />
                    <TextBlock Classes="preview" Text="{Binding AnimePreview}" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Classes="label" Text="{l:Tr FormatMusic}" />
                    <TextBox Text="{Binding MusicTemplate}" />
                    <TextBlock Classes="preview" Text="{Binding MusicPreview}" />
                </StackPanel>
                <HyperlinkButton Content="{l:Tr RestoreFormats}" Command="{Binding RestoreDefaultTemplatesCommand}" Padding="0" />
            </StackPanel>

            <!-- Database online -->
            <StackPanel Spacing="10" IsVisible="{Binding IsMediaMode}">
                <TextBlock Text="{l:Tr SettingsDatabases}" Theme="{StaticResource BodyStrongTextBlockStyle}" />
                <TextBlock Classes="hint"
                           Text="{l:Tr SettingsKeysHintLinux}" />
                <StackPanel>
                    <TextBlock Classes="label" Text="TheMovieDB (API key v3)" />
                    <TextBox PasswordChar="●" Classes="revealPasswordButton" Text="{Binding TmdbApiKey}" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Classes="label" Text="OMDb (API key)" />
                    <TextBox PasswordChar="●" Classes="revealPasswordButton" Text="{Binding OmdbApiKey}" />
                </StackPanel>
                <Grid ColumnDefinitions="2*,*" ColumnSpacing="12">
                    <StackPanel>
                        <TextBlock Classes="label" Text="TheTVDB (API key v4)" />
                        <TextBox PasswordChar="●" Classes="revealPasswordButton" Text="{Binding TheTvdbApiKey}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Classes="label" Text="{l:Tr SettingsTvdbPin}" />
                        <TextBox PasswordChar="●" Classes="revealPasswordButton" Text="{Binding TheTvdbPin}" />
                    </StackPanel>
                </Grid>
                <StackPanel>
                    <TextBlock Classes="label" Text="AcoustID (client key)" />
                    <TextBox PasswordChar="●" Classes="revealPasswordButton" Text="{Binding AcoustIdClientKey}" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Classes="label" Text="{l:Tr SettingsAniDbClient}" />
                    <TextBox Text="{Binding AniDbClientName}" />
                </StackPanel>
            </StackPanel>

            <!-- Riconoscimento -->
            <StackPanel Spacing="10" IsVisible="{Binding IsMediaMode}">
                <TextBlock Text="{l:Tr SettingsRecognition}" Theme="{StaticResource BodyStrongTextBlockStyle}" />
                <StackPanel>
                    <TextBlock Classes="label">
                        <Run Text="{l:Tr SettingsMinConfidence}" /><Run Text=":" />
                        <Run Text="{Binding HighConfidencePercent}" FontWeight="SemiBold" />
                    </TextBlock>
                    <Slider Minimum="50" Maximum="99" TickFrequency="1" IsSnapToTickEnabled="True"
                            Value="{Binding HighConfidencePercent}" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Classes="label" Text="{l:Tr TitleLanguage}" />
                    <ComboBox ItemsSource="{Binding Languages}" SelectedItem="{Binding Language}" MinWidth="200" />
                </StackPanel>
            </StackPanel>

            <!-- Interfaccia: sempre visibile, in tutte e due le modalità -->
            <StackPanel Spacing="10">
                <TextBlock Text="{l:Tr SettingsInterface}" Theme="{StaticResource BodyStrongTextBlockStyle}" />
                <StackPanel>
                    <TextBlock Classes="label" Text="{l:Tr SettingsUiLanguage}" />
                    <ComboBox ItemsSource="{Binding UiLanguages}" SelectedItem="{Binding UiLanguage}" MinWidth="200"
                              DisplayMemberBinding="{Binding Label, x:DataType=vm:UiLanguageOption}" />
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</ctl:FAContentDialog>
