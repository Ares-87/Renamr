<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="using:Renamr.Linux.Helpers"
        xmlns:vm="using:Renamr.Presentation.ViewModels"
        xmlns:ui="using:Renamr.Linux.Helpers"
        xmlns:ctl="using:FluentAvalonia.UI.Controls"
        x:Class="Renamr.Linux.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="{Binding AppTitle}"
        Icon="/Assets/renamr-icon.png"
        Width="1120" Height="740" MinWidth="760" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource SolidBackgroundFillColorBaseBrush}">

    <!-- Stessa struttura di Renamr.App/MainWindow.xaml: intestazione, contenuto, errori, barra azione. -->
    <Window.Styles>
        <Style Selector="Border.badge.success"><Setter Property="Background" Value="{DynamicResource SystemFillColorSuccessBackgroundBrush}" /></Style>
        <Style Selector="Border.badge.success > TextBlock"><Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" /></Style>
        <Style Selector="Border.badge.caution"><Setter Property="Background" Value="{DynamicResource SystemFillColorCautionBackgroundBrush}" /></Style>
        <Style Selector="Border.badge.caution > TextBlock"><Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" /></Style>
        <Style Selector="Border.badge.critical"><Setter Property="Background" Value="{DynamicResource SystemFillColorCriticalBackgroundBrush}" /></Style>
        <Style Selector="Border.badge.critical > TextBlock"><Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" /></Style>
        <Style Selector="Border.badge.neutral"><Setter Property="Background" Value="{DynamicResource SystemFillColorNeutralBackgroundBrush}" /></Style>
        <Style Selector="Border.badge.neutral > TextBlock"><Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" /></Style>
        <Style Selector="TextBlock.detail.success"><Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" /></Style>
        <Style Selector="TextBlock.detail.caution"><Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" /></Style>
        <Style Selector="TextBlock.detail.critical"><Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" /></Style>
        <Style Selector="TextBlock.detail.neutral"><Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" /></Style>
        <!-- Schede della modalità: ognuna col suo colore e la sua icona, quella scelta piena (come Renamr.App). -->
        <Style Selector="Button.modeTab">
            <Setter Property="Padding" Value="8,6,16,6" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Template">
                <ControlTemplate>
                    <ContentPresenter Name="PART_ContentPresenter"
                                      Background="{TemplateBinding Background}"
                                      BorderBrush="{TemplateBinding BorderBrush}"
                                      BorderThickness="{TemplateBinding BorderThickness}"
                                      CornerRadius="{TemplateBinding CornerRadius}"
                                      Padding="{TemplateBinding Padding}"
                                      Content="{TemplateBinding Content}"
                                      Foreground="{TemplateBinding Foreground}" />
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.modeTab:disabled"><Setter Property="Opacity" Value="0.55" /></Style>
        <Style Selector="Button.modeTab Border.modeIcon">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style Selector="Button.modeTab TextBlock.modeHint">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Opacity" Value="0.75" />
        </Style>
        <Style Selector="Button.modeTab.media"><Setter Property="Background" Value="#1A2F6BFF" /><Setter Property="BorderBrush" Value="#552F6BFF" /></Style>
        <Style Selector="Button.modeTab.media:pointerover"><Setter Property="Background" Value="#302F6BFF" /></Style>
        <Style Selector="Button.modeTab.media Border.modeIcon"><Setter Property="Background" Value="#302F6BFF" /></Style>
        <Style Selector="Button.modeTab.media ctl|FASymbolIcon"><Setter Property="Foreground" Value="#2F6BFF" /></Style>
        <Style Selector="Button.modeTab.batch"><Setter Property="Background" Value="#1AE8590C" /><Setter Property="BorderBrush" Value="#55E8590C" /></Style>
        <Style Selector="Button.modeTab.batch:pointerover"><Setter Property="Background" Value="#30E8590C" /></Style>
        <Style Selector="Button.modeTab.batch Border.modeIcon"><Setter Property="Background" Value="#30E8590C" /></Style>
        <Style Selector="Button.modeTab.batch ctl|FASymbolIcon"><Setter Property="Foreground" Value="#E8590C" /></Style>
        <!-- Scheda scelta: piena del suo colore, testo e icona bianchi. Dopo le altre, così vince. -->
        <Style Selector="Button.modeTab.selected"><Setter Property="Foreground" Value="White" /></Style>
        <Style Selector="Button.modeTab.media.selected"><Setter Property="Background" Value="#2F6BFF" /><Setter Property="BorderBrush" Value="#2F6BFF" /></Style>
        <Style Selector="Button.modeTab.batch.selected"><Setter Property="Background" Value="#E8590C" /><Setter Property="BorderBrush" Value="#E8590C" /></Style>
        <Style Selector="Button.modeTab.selected Border.modeIcon"><Setter Property="Background" Value="#38FFFFFF" /></Style>
        <Style Selector="Button.modeTab.selected ctl|FASymbolIcon"><Setter Property="Foreground" Value="White" /></Style>
        <Style Selector="Button.modeTab.selected TextBlock.modeHint"><Setter Property="Opacity" Value="0.9" /></Style>
        <Style Selector="Border.ruleCard">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12,8,8,12" />
        </Style>
        <Style Selector="Border.ruleCard ctl|FANumberBox">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>
        <!-- "Scegli…" sotto lo stato delle righe incerte: un link, non un pulsante pieno. -->
        <Style Selector="Button.link">
            <Setter Property="Padding" Value="2,0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.link:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.icon">
            <Setter Property="Padding" Value="6" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="Border.versionPill">
            <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="7,1,7,2" />
        </Style>
        <Style Selector="Border.versionPill > TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style Selector="Rectangle#DropZoneOutline.active">
            <Setter Property="Stroke" Value="{DynamicResource AccentFillColorDefaultBrush}" />
            <Setter Property="Fill" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
        </Style>
    </Window.Styles>

    <Window.Resources>
        <!-- Intestazione comune delle schede regola: attiva/spenta, numero e nome, sposta e togli. -->
        <DataTemplate x:Key="RuleHeader" x:DataType="vm:BatchRuleViewModel">
            <StackPanel Spacing="2">
                <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="2">
                    <CheckBox IsChecked="{Binding Enabled}" MinWidth="0" Padding="4,0,0,0" ToolTip.Tip="{l:Tr RuleToggleTip}" />
                    <TextBlock Grid.Column="1" Text="{Binding Header}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <Button Grid.Column="2" Classes="icon" Command="{Binding MoveUpCommand}" ToolTip.Tip="{l:Tr RuleMoveUp}">
                        <ctl:FASymbolIcon Symbol="ChevronUp" FontSize="12" />
                    </Button>
                    <Button Grid.Column="3" Classes="icon" Command="{Binding MoveDownCommand}" ToolTip.Tip="{l:Tr RuleMoveDown}">
                        <ctl:FASymbolIcon Symbol="ChevronDown" FontSize="12" />
                    </Button>
                    <Button Grid.Column="4" Classes="icon" Command="{Binding RemoveCommand}" ToolTip.Tip="{l:Tr RuleRemove}">
                        <ctl:FASymbolIcon Symbol="Dismiss" FontSize="12" />
                    </Button>
                </Grid>
                <TextBlock Text="{Binding Description}" Classes="caption" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <Grid x:Name="RootGrid" DragDrop.AllowDrop="True" RowDefinitions="56,Auto,*,Auto,Auto">

        <!-- ═══ Intestazione: logo e versione, cartella aperta ═══ -->
        <Grid Margin="24,0" ColumnDefinitions="Auto,Auto,*" ColumnSpacing="10">
            <Image Source="{DynamicResource RenamrWordmark}" Height="20" VerticalAlignment="Center"
                   ToolTip.Tip="{Binding AppDetails}" />
            <Border Grid.Column="1" Classes="versionPill" VerticalAlignment="Center">
                <TextBlock Text="{Binding AppVersion}" />
            </Border>
            <TextBlock Grid.Column="2" Classes="caption" VerticalAlignment="Center" HorizontalAlignment="Right"
                       Text="{Binding SourceLabel}"
                       TextTrimming="CharacterEllipsis"
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
        </Grid>

        <!-- ═══ Modalità a sinistra, caffè e impostazioni a destra: sempre a portata, in ogni fase ═══ -->
        <Grid Grid.Row="1" Margin="20,4,24,8" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="4">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="MediaTab" Classes="modeTab media" Click="MediaTab_Click" IsEnabled="{Binding !IsBusy}"
                        ToolTip.Tip="{l:Tr ModeMediaTip}">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Border Classes="modeIcon" Width="44">
                            <StackPanel Orientation="Horizontal" Spacing="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <ctl:FASymbolIcon Symbol="Video" FontSize="17" />
                                <ctl:FASymbolIcon Symbol="Audio" FontSize="15" />
                            </StackPanel>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{l:Tr ModeMedia}" FontSize="14" FontWeight="SemiBold" />
                            <TextBlock Classes="modeHint" Text="{l:Tr ModeMediaHint}" />
                        </StackPanel>
                    </StackPanel>
                </Button>
                <Button x:Name="BatchTab" Classes="modeTab batch" Click="BatchTab_Click" IsEnabled="{Binding !IsBusy}"
                        ToolTip.Tip="{l:Tr ModeBatchTip}">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Border Classes="modeIcon">
                            <ctl:FASymbolIcon Symbol="Rename" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{l:Tr ModeBatch}" FontSize="14" FontWeight="SemiBold" />
                            <TextBlock Classes="modeHint" Text="{l:Tr ModeBatchHint}" />
                        </StackPanel>
                    </StackPanel>
                </Button>
            </StackPanel>
            <!-- Offri un caffè: la tazzina ogni tanto oscilla per farsi notare (CoffeeWiggle). -->
            <Button Grid.Column="1" Classes="icon" Click="Coffee_Click" VerticalAlignment="Center" ToolTip.Tip="{l:Tr Donate}">
                <Canvas x:Name="CoffeeCup" Width="24" Height="24" RenderTransformOrigin="50%,80%">
                    <Canvas.RenderTransform><RotateTransform /></Canvas.RenderTransform>
                    <Path x:Name="CoffeeSteam" Opacity="0.55" Stroke="#D9822B" StrokeThickness="1.5" StrokeLineCap="Round"
                          Data="M7,7.5 C5.8,6 8.2,4.8 7,3 M10.5,7.5 C9.3,6 11.7,4.8 10.5,3 M14,7.5 C12.8,6 15.2,4.8 14,3">
                        <Path.RenderTransform><TranslateTransform /></Path.RenderTransform>
                    </Path>
                    <Path Fill="#D9822B" Data="M3.5,9.5 H17.5 V14 A5,5 0 0 1 12.5,19 H8.5 A5,5 0 0 1 3.5,14 Z" />
                    <Path Stroke="#D9822B" StrokeThickness="1.6" StrokeLineCap="Round"
                          Data="M17.5,11 H18.75 A2.25,2.25 0 0 1 18.75,15.5 H17 M2.5,21.2 H18.5" />
                </Canvas>
            </Button>
            <Button Grid.Column="2" Classes="icon" Click="Settings_Click" VerticalAlignment="Center"
                    ToolTip.Tip="{l:Tr Settings}" IsEnabled="{Binding !IsBusy}">
                <ctl:FASymbolIcon Symbol="Settings" FontSize="18" />
            </Button>
        </Grid>

        <!-- ═══ FASE 1 · Selezione & Drag-and-Drop ═══ -->
        <Grid Grid.Row="2" Margin="48,16,48,48" IsVisible="{Binding IsSelectPhase}">
            <Rectangle x:Name="DropZoneOutline"
                       RadiusX="12" RadiusY="12"
                       StrokeThickness="2"
                       StrokeDashArray="5,4"
                       Stroke="{DynamicResource ControlStrongStrokeColorDefaultBrush}"
                       Fill="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" MaxWidth="440">
                <Image Source="{DynamicResource RenamrLogo}" Height="64" Margin="0,0,0,12" HorizontalAlignment="Center" />
                <TextBlock x:Name="DropZoneTitle"
                           Text="{Binding DropZoneTitle}"
                           Theme="{StaticResource SubtitleTextBlockStyle}"
                           TextAlignment="Center" HorizontalAlignment="Center" />
                <TextBlock Text="{Binding DropZoneHint}"
                           Theme="{StaticResource BodyTextBlockStyle}"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           TextAlignment="Center" TextWrapping="Wrap" />
                <!-- Una cartella intera, oppure solo alcuni file (anche da cartelle diverse). -->
                <StackPanel Margin="0,12,0,0" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                    <Button Classes="accent" Command="{Binding PickFolderCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ctl:FASymbolIcon Symbol="OpenFolder" FontSize="16" />
                            <TextBlock Text="{l:Tr PickFolder}" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding PickFilesCommand}" ToolTip.Tip="{l:Tr AddFilesTip}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ctl:FASymbolIcon Symbol="Document" FontSize="16" />
                            <TextBlock Text="{l:Tr PickFiles}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <!-- Dopo un'analisi annullata o un cambio di modalità: l'analisi online riparte solo da qui. -->
                <Button HorizontalAlignment="Center"
                        IsVisible="{Binding CanAnalyzeLastFolder}"
                        Command="{Binding AnalyzeLastFolderCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ctl:FASymbolIcon Symbol="Find" FontSize="16" />
                        <TextBlock Text="{Binding AnalyzeLastFolderText}" TextTrimming="CharacterEllipsis" MaxWidth="360" />
                    </StackPanel>
                </Button>
                <StackPanel Margin="0,8,0,0" HorizontalAlignment="Center" Spacing="4" IsVisible="{Binding IsMediaMode}">
                    <TextBlock Text="{l:Tr TitleLanguage}" />
                    <ComboBox MinWidth="200"
                              ItemsSource="{Binding Languages}"
                              SelectedItem="{Binding SelectedLanguage}"
                              DisplayMemberBinding="{Binding Label, x:DataType=vm:LanguageOption}" />
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- ═══ FASE 2 · Anteprima intelligente (Diff View), con le regole a sinistra in modalità "Rinomina file" ═══ -->
        <Grid Grid.Row="2" Margin="24,8,24,0" ColumnDefinitions="Auto,*"
              IsVisible="{Binding IsPreviewVisible}">

            <!-- Pannello regole: quali file, in che ordine, e le regole applicate una dopo l'altra -->
            <ScrollViewer Width="340" Margin="0,0,16,0" IsVisible="{Binding IsBatchMode}" IsEnabled="{Binding !IsBusy}"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="12" Margin="0,0,12,12" DataContext="{Binding Batch}" x:DataType="vm:BatchRenameViewModel">
                    <TextBlock Text="{l:Tr BatchFiles}" Theme="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBox Text="{Binding Filter}" PlaceholderText="{l:Tr BatchFilterPlaceholder}"
                             ToolTip.Tip="{l:Tr BatchFilterTip}" />
                    <CheckBox Content="{l:Tr IncludeSubfolders}" IsChecked="{Binding IncludeSubfolders}" />
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                        <TextBlock Text="{l:Tr SortOrder}" VerticalAlignment="Center" />
                        <ComboBox Grid.Column="1" HorizontalAlignment="Stretch"
                                  ItemsSource="{x:Static vm:BatchRenameViewModel.SortOptions}"
                                  SelectedIndex="{Binding SortByIndex}"
                                  ToolTip.Tip="{l:Tr SortOrderTip}" />
                        <CheckBox Grid.Column="2" Content="{l:Tr SortDescending}" IsChecked="{Binding Descending}" />
                    </Grid>

                    <Grid ColumnDefinitions="*,Auto" Margin="0,8,0,0">
                        <TextBlock Text="{l:Tr Rules}" Theme="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Classes="icon" Command="{Binding ClearRulesCommand}" IsVisible="{Binding HasRules}"
                                ToolTip.Tip="{l:Tr ClearRules}">
                            <ctl:FASymbolIcon Symbol="Delete" FontSize="14" />
                        </Button>
                    </Grid>
                    <TextBlock Text="{l:Tr NoRules}"
                               IsVisible="{Binding !HasRules}" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                    <ItemsControl ItemsSource="{Binding Rules}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Spacing="8" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.DataTemplates>
                            <DataTemplate DataType="vm:NumberingRuleViewModel">
                                <Border Classes="ruleCard">
                                    <StackPanel Spacing="8">
                                        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource RuleHeader}" />
                                        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="8">
                                            <ComboBox Grid.ColumnSpan="2" HorizontalAlignment="Stretch"
                                                      ItemsSource="{x:Static vm:NumberingRuleViewModel.Positions}"
                                                      SelectedIndex="{Binding PositionIndex}" />
                                            <ctl:FANumberBox Grid.Row="1" Header="{l:Tr NumberingFrom}" Value="{Binding Start, Mode=TwoWay}" SpinButtonPlacementMode="Compact" />
                                            <ctl:FANumberBox Grid.Row="1" Grid.Column="1" Header="{l:Tr NumberingStep}" Value="{Binding Step, Mode=TwoWay}" SpinButtonPlacementMode="Compact" />
                                            <ctl:FANumberBox Grid.Row="2" Header="{l:Tr NumberingDigits}" Value="{Binding Digits, Mode=TwoWay}" Minimum="0" Maximum="12" SpinButtonPlacementMode="Compact"
                                                             ToolTip.Tip="{l:Tr NumberingDigitsTip}" />
                                            <StackPanel Grid.Row="2" Grid.Column="1" Spacing="4">
                                                <TextBlock Text="{l:Tr NumberingSeparator}" />
                                                <TextBox Text="{Binding Separator}" />
                                            </StackPanel>
                                        </Grid>
                                        <CheckBox Content="{l:Tr NumberingRestart}" IsChecked="{Binding RestartInEachFolder}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                            <DataTemplate DataType="vm:NewNameRuleViewModel">
                                <Border Classes="ruleCard">
                                    <StackPanel Spacing="8">
                                        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource RuleHeader}" />
                                        <TextBox Text="{Binding Pattern}" PlaceholderText="{l:Tr NewNamePlaceholder}" />
                                        <TextBlock Text="{x:Static vm:NewNameRuleViewModel.TokensHelp}" Classes="caption" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                        <Expander Header="{l:Tr MoreTokens}" HorizontalAlignment="Stretch">
                                            <TextBlock Text="{x:Static vm:NewNameRuleViewModel.MoreTokensHelp}" Classes="caption" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                        </Expander>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                            <DataTemplate DataType="vm:ReplaceTextRuleViewModel">
                                <Border Classes="ruleCard">
                                    <StackPanel Spacing="8">
                                        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource RuleHeader}" />
                                        <TextBox Text="{Binding Find}" PlaceholderText="{l:Tr ReplaceFind}" />
                                        <TextBox Text="{Binding Replacement}" PlaceholderText="{l:Tr ReplaceWith}" />
                                        <WrapPanel ItemSpacing="16">
                                            <CheckBox Content="{l:Tr MatchCase}" IsChecked="{Binding MatchCase}" />
                                            <CheckBox Content="{l:Tr UseRegex}" IsChecked="{Binding UseRegex}" />
                                        </WrapPanel>
                                        <ComboBox HorizontalAlignment="Stretch"
                                                  ItemsSource="{x:Static vm:ReplaceTextRuleViewModel.Occurrences}"
                                                  SelectedIndex="{Binding OccurrenceIndex}" />
                                        <TextBlock Text="{Binding Error}" IsVisible="{Binding HasError}" Classes="caption" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                            <DataTemplate DataType="vm:InsertTextRuleViewModel">
                                <Border Classes="ruleCard">
                                    <StackPanel Spacing="8">
                                        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource RuleHeader}" />
                                        <TextBox Text="{Binding Text}" PlaceholderText="{l:Tr InsertPlaceholder}" />
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                            <ComboBox HorizontalAlignment="Stretch" VerticalAlignment="Bottom"
                                                      ItemsSource="{x:Static vm:InsertTextRuleViewModel.Positions}"
                                                      SelectedIndex="{Binding PositionIndex}" />
                                            <ctl:FANumberBox Grid.Column="1" Width="110" Value="{Binding Index, Mode=TwoWay}" Minimum="0"
                                                             SpinButtonPlacementMode="Compact" IsVisible="{Binding IsAtIndex}" />
                                        </Grid>
                                        <TextBox Text="{Binding Anchor}" PlaceholderText="{l:Tr InsertAnchorPlaceholder}" IsVisible="{Binding IsAtText}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                            <DataTemplate DataType="vm:RemoveCharactersRuleViewModel">
                                <Border Classes="ruleCard">
                                    <StackPanel Spacing="8">
                                        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource RuleHeader}" />
                                        <ComboBox HorizontalAlignment="Stretch"
                                                  ItemsSource="{x:Static vm:RemoveCharactersRuleViewModel.Modes}"
                                                  SelectedIndex="{Binding ModeIndex}" />
                                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                            <ctl:FANumberBox Header="{l:Tr RemoveCount}" Value="{Binding Count, Mode=TwoWay}" Minimum="0" SpinButtonPlacementMode="Compact"
                                                             IsVisible="{Binding IsCount}" />
                                            <ctl:FANumberBox Grid.Column="1" Header="{l:Tr RemoveFrom}" Value="{Binding From, Mode=TwoWay}" Minimum="1"
                                                             SpinButtonPlacementMode="Compact" IsVisible="{Binding IsRange}" />
                                        </Grid>
                                        <TextBox Text="{Binding Characters}" PlaceholderText="{l:Tr RemoveCharactersPlaceholder}" IsVisible="{Binding IsCharacterList}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                            <DataTemplate DataType="vm:ChangeCaseRuleViewModel">
                                <Border Classes="ruleCard">
                                    <StackPanel Spacing="8">
                                        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource RuleHeader}" />
                                        <ComboBox HorizontalAlignment="Stretch"
                                                  ItemsSource="{x:Static vm:ChangeCaseRuleViewModel.Modes}"
                                                  SelectedIndex="{Binding ModeIndex}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                            <DataTemplate DataType="vm:CleanupRuleViewModel">
                                <Border Classes="ruleCard">
                                    <StackPanel Spacing="4">
                                        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource RuleHeader}" />
                                        <CheckBox Content="{l:Tr CleanupSeparators}" IsChecked="{Binding SeparatorsToSpaces}" />
                                        <CheckBox Content="{l:Tr CleanupBrackets}" IsChecked="{Binding RemoveBracketed}" />
                                        <CheckBox Content="{l:Tr CleanupAccents}" IsChecked="{Binding RemoveAccents}" />
                                        <CheckBox Content="{l:Tr CleanupDigits}" IsChecked="{Binding RemoveDigits}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                            <DataTemplate DataType="vm:LettersToDigitsRuleViewModel">
                                <Border Classes="ruleCard">
                                    <StackPanel Spacing="4">
                                        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource RuleHeader}" />
                                        <Grid ColumnDefinitions="*,*,*,*" RowDefinitions="Auto,Auto">
                                            <CheckBox Grid.Row="0" Grid.Column="0" Content="A ➔ 4" IsChecked="{Binding A}" />
                                            <CheckBox Grid.Row="0" Grid.Column="1" Content="E ➔ 3" IsChecked="{Binding E}" />
                                            <CheckBox Grid.Row="0" Grid.Column="2" Content="I ➔ 1" IsChecked="{Binding I}" />
                                            <CheckBox Grid.Row="0" Grid.Column="3" Content="O ➔ 0" IsChecked="{Binding O}" />
                                            <CheckBox Grid.Row="1" Grid.Column="0" Content="S ➔ 5" IsChecked="{Binding S}" />
                                            <CheckBox Grid.Row="1" Grid.Column="1" Content="T ➔ 7" IsChecked="{Binding T}" />
                                            <CheckBox Grid.Row="1" Grid.Column="2" Content="B ➔ 8" IsChecked="{Binding B}" />
                                            <CheckBox Grid.Row="1" Grid.Column="3" Content="G ➔ 6" IsChecked="{Binding G}" />
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                            <DataTemplate DataType="vm:ExtensionRuleViewModel">
                                <Border Classes="ruleCard">
                                    <StackPanel Spacing="8">
                                        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource RuleHeader}" />
                                        <ComboBox HorizontalAlignment="Stretch"
                                                  ItemsSource="{x:Static vm:ExtensionRuleViewModel.Modes}"
                                                  SelectedIndex="{Binding ModeIndex}" />
                                        <TextBox Text="{Binding NewExtension}" PlaceholderText="jpg" IsVisible="{Binding IsReplace}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                            <DataTemplate DataType="vm:MoveTextRuleViewModel">
                                <Border Classes="ruleCard">
                                    <StackPanel Spacing="8">
                                        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource RuleHeader}" />
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="{l:Tr MoveWhat}" />
                                            <ComboBox HorizontalAlignment="Stretch"
                                                      ItemsSource="{x:Static vm:MoveTextRuleViewModel.Sources}"
                                                      SelectedIndex="{Binding SourceIndex}" />
                                        </StackPanel>
                                        <StackPanel Spacing="8" IsVisible="{Binding IsText}">
                                            <TextBox Text="{Binding Find}" PlaceholderText="{l:Tr MoveFindPlaceholder}" />
                                            <WrapPanel ItemSpacing="16">
                                                <CheckBox Content="{l:Tr MatchCase}" IsChecked="{Binding MatchCase}" />
                                                <CheckBox Content="{l:Tr UseRegex}" IsChecked="{Binding UseRegex}" />
                                            </WrapPanel>
                                        </StackPanel>
                                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8" IsVisible="{Binding IsCharacters}">
                                            <ctl:FANumberBox Header="{l:Tr RemoveFrom}" Value="{Binding From, Mode=TwoWay}" Minimum="1" SpinButtonPlacementMode="Compact" />
                                            <ctl:FANumberBox Grid.Column="1" Header="{l:Tr RemoveCount}" Value="{Binding Count, Mode=TwoWay}" Minimum="0" SpinButtonPlacementMode="Compact" />
                                        </Grid>
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="{l:Tr MoveWhere}" />
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                <ComboBox HorizontalAlignment="Stretch"
                                                          ItemsSource="{x:Static vm:MoveTextRuleViewModel.Targets}"
                                                          SelectedIndex="{Binding TargetIndex}" />
                                                <ctl:FANumberBox Grid.Column="1" Width="110" Value="{Binding TargetPosition, Mode=TwoWay}" Minimum="0"
                                                                 SpinButtonPlacementMode="Compact" IsVisible="{Binding IsAtIndex}" />
                                            </Grid>
                                        </StackPanel>
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="{l:Tr NumberingSeparator}" />
                                            <TextBox Text="{Binding Separator}" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding Error}" IsVisible="{Binding HasError}" Classes="caption" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                            <DataTemplate DataType="vm:SwapPartsRuleViewModel">
                                <Border Classes="ruleCard">
                                    <StackPanel Spacing="8">
                                        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource RuleHeader}" />
                                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                            <StackPanel Spacing="4" VerticalAlignment="Bottom">
                                                <TextBlock Text="{l:Tr NumberingSeparator}" />
                                                <TextBox Text="{Binding Separator}" />
                                            </StackPanel>
                                            <ctl:FANumberBox Grid.Column="1" Header="{l:Tr SwapOccurrence}" Value="{Binding Occurrence, Mode=TwoWay}" Minimum="1"
                                                             SpinButtonPlacementMode="Compact" />
                                        </Grid>
                                        <CheckBox Content="{l:Tr CountFromEnd}" IsChecked="{Binding FromEnd}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                            <DataTemplate DataType="vm:RenumberRuleViewModel">
                                <Border Classes="ruleCard">
                                    <StackPanel Spacing="8">
                                        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource RuleHeader}" />
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                            <ctl:FANumberBox Header="{l:Tr RenumberWhich}" Value="{Binding Which, Mode=TwoWay}" Minimum="1" SpinButtonPlacementMode="Compact" />
                                            <CheckBox Grid.Column="1" VerticalAlignment="Bottom" Content="{l:Tr CountFromEnd}" IsChecked="{Binding FromEnd}" />
                                        </Grid>
                                        <ComboBox HorizontalAlignment="Stretch"
                                                  ItemsSource="{x:Static vm:RenumberRuleViewModel.Modes}"
                                                  SelectedIndex="{Binding ModeIndex}" />
                                        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="8">
                                            <ctl:FANumberBox Header="{l:Tr NumberingFrom}" Value="{Binding Start, Mode=TwoWay}" SpinButtonPlacementMode="Compact"
                                                             IsVisible="{Binding IsSequence}" />
                                            <ctl:FANumberBox Grid.Column="1" Header="{l:Tr NumberingStep}" Value="{Binding Step, Mode=TwoWay}" SpinButtonPlacementMode="Compact"
                                                             IsVisible="{Binding IsSequence}" />
                                            <ctl:FANumberBox Grid.ColumnSpan="2" Header="{l:Tr RenumberAdd}" Value="{Binding Add, Mode=TwoWay}" SpinButtonPlacementMode="Compact"
                                                             IsVisible="{Binding IsAdd}" />
                                            <ctl:FANumberBox Grid.Row="1" Header="{l:Tr NumberingDigits}" Value="{Binding Digits, Mode=TwoWay}" Minimum="0" Maximum="12"
                                                             SpinButtonPlacementMode="Compact" ToolTip.Tip="{l:Tr RenumberDigitsTip}" />
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                            <DataTemplate DataType="vm:TrimRuleViewModel">
                                <Border Classes="ruleCard">
                                    <StackPanel Spacing="8">
                                        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource RuleHeader}" />
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="{l:Tr TrimCharacters}" />
                                            <TextBox Text="{Binding Characters}" />
                                        </StackPanel>
                                        <ComboBox HorizontalAlignment="Stretch"
                                                  ItemsSource="{x:Static vm:TrimRuleViewModel.Places}"
                                                  SelectedIndex="{Binding WhereIndex}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                            <DataTemplate DataType="vm:NameListRuleViewModel">
                                <Border Classes="ruleCard">
                                    <StackPanel Spacing="8">
                                        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource RuleHeader}" />
                                        <TextBox Text="{Binding Names}" PlaceholderText="{l:Tr NameListPlaceholder}"
                                                 AcceptsReturn="True" TextWrapping="NoWrap" MinHeight="96" MaxHeight="240" />
                                        <Button Content="{l:Tr NameListFill}" Command="{Binding FillWithCurrentNamesCommand}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                            <DataTemplate DataType="vm:ReplaceListRuleViewModel">
                                <Border Classes="ruleCard">
                                    <StackPanel Spacing="8">
                                        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource RuleHeader}" />
                                        <ItemsControl ItemsSource="{Binding Pairs}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><StackPanel Spacing="4" /></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="vm:ReplacePairViewModel">
                                                    <Grid ColumnDefinitions="*,Auto,*,Auto" ColumnSpacing="4">
                                                        <TextBox Text="{Binding Find}" PlaceholderText="{l:Tr ReplaceFind}" />
                                                        <TextBlock Grid.Column="1" Text="➔" VerticalAlignment="Center" />
                                                        <TextBox Grid.Column="2" Text="{Binding Replacement}" />
                                                        <Button Grid.Column="3" Classes="icon" Command="{Binding RemoveCommand}" ToolTip.Tip="{l:Tr ReplaceListRemovePair}">
                                                            <ctl:FASymbolIcon Symbol="Dismiss" FontSize="12" />
                                                        </Button>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <Button Command="{Binding AddPairCommand}">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <ctl:FASymbolIcon Symbol="Add" FontSize="12" />
                                                <TextBlock Text="{l:Tr ReplaceListAdd}" />
                                            </StackPanel>
                                        </Button>
                                        <WrapPanel ItemSpacing="16">
                                            <CheckBox Content="{l:Tr MatchCase}" IsChecked="{Binding MatchCase}" />
                                            <CheckBox Content="{l:Tr UseRegex}" IsChecked="{Binding UseRegex}" />
                                        </WrapPanel>
                                        <TextBlock Text="{Binding Error}" IsVisible="{Binding HasError}" Classes="caption" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.DataTemplates>
                    </ItemsControl>

                    <Button x:Name="AddRuleButton" HorizontalAlignment="Stretch" Click="AddRule_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                            <ctl:FASymbolIcon Symbol="Add" FontSize="14" />
                            <TextBlock Text="{l:Tr AddRule}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </ScrollViewer>

        <Grid Grid.Column="1" RowSpacing="12" RowDefinitions="Auto,Auto,Auto,Auto,*">

            <!-- Riepilogo a pillole: niente toolbar, solo informazione. A destra si aggiungono file singoli. -->
            <Grid ColumnDefinitions="*,Auto">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Border Classes="badge success">
                    <TextBlock><Run Text="{l:Tr BadgeReady}" /> <Run Text="{Binding ReadyCount}" /></TextBlock>
                </Border>
                <Border Classes="badge caution" IsVisible="{Binding IsMediaMode}">
                    <TextBlock><Run Text="{l:Tr BadgeLowConfidence}" /> <Run Text="{Binding LowConfidenceCount}" /></TextBlock>
                </Border>
                <Border Classes="badge critical">
                    <TextBlock><Run Text="{l:Tr BadgeErrors}" /> <Run Text="{Binding ErrorCount}" /></TextBlock>
                </Border>
            </StackPanel>
            <Button Grid.Column="1" Command="{Binding PickFilesCommand}" IsEnabled="{Binding !IsBusy}"
                    ToolTip.Tip="{l:Tr AddFilesTip}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <ctl:FASymbolIcon Symbol="Add" FontSize="14" />
                    <TextBlock Text="{l:Tr AddFiles}" />
                </StackPanel>
            </Button>
            </Grid>

            <!-- Esito dell'esecuzione, con "Annulla" a portata di mano -->
            <ctl:FAInfoBar Grid.Row="1"
                           IsOpen="{Binding IsSummaryOpen}"
                           Title="{Binding SummaryTitle}"
                           Message="{Binding SummaryMessage}"
                           Severity="{Binding SummaryHasErrors, Converter={x:Static ui:Ui.Severity}}">
                <ctl:FAInfoBar.ActionButton>
                    <Button Content="{l:Tr UndoRename}"
                            Command="{Binding UndoCommand}"
                            IsVisible="{Binding CanUndo}" />
                </ctl:FAInfoBar.ActionButton>
            </ctl:FAInfoBar>

            <!-- Perché alcuni titoli restano in inglese, e quali date questo disco permette di cambiare -->
            <StackPanel Grid.Row="2" Spacing="8">
                <ctl:FAInfoBar Severity="Warning"
                               Title="{l:Tr ProviderWarningTitle}"
                               IsOpen="{Binding IsProviderWarningOpen}"
                               Message="{Binding ProviderWarning}" />
                <ctl:FAInfoBar Severity="Informational"
                               Title="{l:Tr TranslatedTitlesTitle}"
                               IsOpen="{Binding IsLanguageHintOpen}"
                               Message="{Binding LanguageHint}" />
                <ctl:FAInfoBar x:Name="DateHintBar"
                               Severity="Informational"
                               Title="{l:Tr CreationDateTitle}"
                               IsOpen="False" />
            </StackPanel>

            <!-- Intestazione colonne -->
            <Grid Grid.Row="3" Margin="16,0" ColumnDefinitions="140,*,24,*,28" ColumnSpacing="12">
                <TextBlock Text="{l:Tr ColumnStatus}" Classes="columnHeader" />
                <TextBlock Grid.Column="1" Text="{l:Tr ColumnOriginal}" Classes="columnHeader" />
                <TextBlock Grid.Column="3" Text="{l:Tr ColumnProposed}" Classes="columnHeader" />
            </Grid>

            <!-- Tabella a due colonne: Originale ➔ Proposto. ListBox virtualizzata: regge decine di migliaia di righe. -->
            <!-- Tasto destro: formato del nome e lingua al volo. Clic su una riga di film o serie: scelta del risultato. -->
            <ListBox x:Name="FileList"
                     Grid.Row="4"
                     Classes="diff"
                     ItemsSource="{Binding Items}"
                     Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                     BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                     BorderThickness="1"
                     CornerRadius="8"
                     Padding="0,4">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:FileItemViewModel">
                        <Grid Margin="4,10,0,10" ColumnDefinitions="140,*,24,*,28" ColumnSpacing="12" Background="Transparent">

                            <StackPanel Spacing="2" VerticalAlignment="Center" HorizontalAlignment="Left"
                                        Opacity="{Binding Status, Converter={x:Static ui:Ui.RowOpacity}}">
                                <Border Classes="badge"
                                        Classes.success="{Binding Status, Converter={x:Static ui:Ui.IsSuccess}}"
                                        Classes.caution="{Binding Status, Converter={x:Static ui:Ui.IsCaution}}"
                                        Classes.critical="{Binding Status, Converter={x:Static ui:Ui.IsCritical}}"
                                        Classes.neutral="{Binding Status, Converter={x:Static ui:Ui.IsNeutral}}">
                                    <TextBlock Text="{Binding StatusText}" />
                                </Border>
                                <Button Classes="link" Content="{l:Tr ChooseMatchShort}" Click="ChooseMatch_Click"
                                        IsVisible="{Binding SuggestsChoice}" ToolTip.Tip="{l:Tr ChooseMatchTip}" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center"
                                        Opacity="{Binding Status, Converter={x:Static ui:Ui.RowOpacity}}">
                                <TextBlock Text="{Binding OriginalName}"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip.Tip="{Binding OriginalName}" />
                                <TextBlock Text="{Binding RelativeFolder}"
                                           IsVisible="{Binding RelativeFolder, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                           Classes="caption"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                            <ctl:FASymbolIcon Grid.Column="2" Symbol="Forward" FontSize="12"
                                              Foreground="{DynamicResource TextFillColorTertiaryBrush}" />

                            <StackPanel Grid.Column="3" VerticalAlignment="Center"
                                        Opacity="{Binding Status, Converter={x:Static ui:Ui.RowOpacity}}">
                                <TextBlock Text="{Binding ProposedName}"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip.Tip="{Binding ProposedName}" />
                                <TextBlock Text="{Binding MatchSummary}"
                                           IsVisible="{Binding MatchSummary, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                           Classes="caption"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{Binding Detail}"
                                           IsVisible="{Binding Detail, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                           Classes="caption detail"
                                           Classes.success="{Binding Status, Converter={x:Static ui:Ui.IsSuccess}}"
                                           Classes.caution="{Binding Status, Converter={x:Static ui:Ui.IsCaution}}"
                                           Classes.critical="{Binding Status, Converter={x:Static ui:Ui.IsCritical}}"
                                           Classes.neutral="{Binding Status, Converter={x:Static ui:Ui.IsNeutral}}"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                            <!-- Togli dall'elenco: il file resta com'è e non torna nemmeno rifacendo l'analisi. -->
                            <Button Grid.Column="4" Classes="icon" Click="RemoveRow_Click" VerticalAlignment="Center"
                                    ToolTip.Tip="{l:Tr RemoveFromList}">
                                <ctl:FASymbolIcon Symbol="Dismiss" FontSize="12" />
                            </Button>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
        </Grid>

        <!-- ═══ Pannello collassabile Errori/Avvisi ═══ -->
        <Expander Grid.Row="3"
                  Margin="24,12,24,0"
                  HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Stretch"
                  IsExpanded="{Binding Issues.IsExpanded}"
                  IsVisible="{Binding Issues.HasIssues}">
            <Expander.Header>
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <ctl:FASymbolIcon Symbol="Important" FontSize="16" Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                    <TextBlock Text="{l:Tr IssuesTitle}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Issues.Header}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Expander.Header>
            <ListBox x:Name="IssueList" ItemsSource="{Binding Issues.Issues}" MaxHeight="220" Classes="diff">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:IssueItemViewModel">
                        <Grid Margin="0,6" ColumnDefinitions="Auto,56,2*,3*" ColumnSpacing="12" Background="Transparent"
                              ToolTip.Tip="{Binding Detail}">
                            <Panel>
                                <ctl:FASymbolIcon Symbol="Important" FontSize="14" IsVisible="{Binding IsWarning}"
                                                  Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                                <ctl:FASymbolIcon Symbol="Dismiss" FontSize="14" IsVisible="{Binding !IsWarning}"
                                                  Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
                            </Panel>
                            <TextBlock Grid.Column="1" Text="{Binding Code}" FontFamily="monospace"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                            <TextBlock Grid.Column="2" Text="{Binding FileName}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="3" Text="{Binding MessageWithDetail}" TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Expander>

        <!-- ═══ FASE 3 · Azione unica + monitoraggio in tempo reale ═══ -->
        <Border Grid.Row="4"
                Margin="0,12,0,0"
                Padding="24,14"
                Background="{DynamicResource LayerFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0"
                IsVisible="{Binding IsPreviewVisible}">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">

                <!-- Opzioni (a riposo) -->
                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center" ItemSpacing="24" LineSpacing="8"
                           IsVisible="{Binding !IsBusy}">
                    <ToggleSwitch IsChecked="{Binding IsDryRun}"
                                  OnContent="{l:Tr DryRun}"
                                  OffContent="{l:Tr DryRun}"
                                  ToolTip.Tip="{l:Tr DryRunTip}" />
                    <ComboBox ItemsSource="{Binding Languages}"
                              SelectedItem="{Binding SelectedLanguage}"
                              DisplayMemberBinding="{Binding Label, x:DataType=vm:LanguageOption}"
                              IsVisible="{Binding IsMediaMode}"
                              MinWidth="130"
                              VerticalAlignment="Center"
                              ToolTip.Tip="{l:Tr TitleLanguageTip}" />
                    <CheckBox Content="{l:Tr WriteMetadata}"
                              IsChecked="{Binding WriteEmbeddedMetadata}"
                              IsVisible="{Binding IsMediaMode}"
                              ToolTip.Tip="{l:Tr WriteMetadataTip}" />
                    <CheckBox IsChecked="{Binding IncludeLowConfidence}"
                              IsVisible="{Binding IsMediaMode}"
                              ToolTip.Tip="{l:Tr IncludeLowConfidenceTip}">
                        <TextBlock>
                            <Run Text="{l:Tr IncludeLowConfidence}" />
                            <Run Text="(" /><Run Text="{Binding LowConfidenceCount}" /><Run Text=")" />
                        </TextBlock>
                    </CheckBox>
                </WrapPanel>

                <!-- Avanzamento (durante analisi/esecuzione) -->
                <Grid VerticalAlignment="Center" RowDefinitions="Auto,Auto" ColumnDefinitions="Auto,*,Auto"
                      RowSpacing="6" ColumnSpacing="12"
                      IsVisible="{Binding IsBusy}">
                    <ctl:FAProgressRing Grid.RowSpan="2" Width="28" Height="28"
                                        Minimum="0" Maximum="100"
                                        IsIndeterminate="{Binding Total, Converter={x:Static ui:Ui.IsZero}}"
                                        Value="{Binding ProgressValue}" />
                    <TextBlock Grid.Column="1" TextTrimming="CharacterEllipsis">
                        <Run Text="{Binding ProgressPhase}" FontWeight="SemiBold" />
                        <Run Text="  " />
                        <Run Text="{Binding CurrentFile}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </TextBlock>
                    <TextBlock Grid.Column="2" Text="{Binding ProgressText}" FontFamily="monospace" />
                    <ProgressBar Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                                 Minimum="0" Maximum="100"
                                 Value="{Binding ProgressValue}"
                                 IsIndeterminate="{Binding Total, Converter={x:Static ui:Ui.IsZero}}" />
                </Grid>

                <!-- Pulsanti: uno primario, il resto discreto -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Command="{Binding CancelCommand}" Content="{l:Tr Cancel}" IsVisible="{Binding IsBusy}" />
                    <Button Content="{l:Tr ChangeFolder}" Command="{Binding ResetCommand}" IsVisible="{Binding !IsBusy}" />
                    <Button Classes="accent" Command="{Binding RunCommand}" MinWidth="220" IsVisible="{Binding !IsBusy}">
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                            <ctl:FASymbolIcon Symbol="Rename" FontSize="16" />
                            <TextBlock Text="{Binding PrimaryActionText}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
