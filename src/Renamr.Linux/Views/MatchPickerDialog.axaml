<ctl:FAContentDialog xmlns="https://github.com/avaloniaui"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:l="using:Renamr.Linux.Helpers"
                     xmlns:ctl="using:FluentAvalonia.UI.Controls"
                     xmlns:vm="using:Renamr.Presentation.ViewModels"
                     x:Class="Renamr.Linux.Views.MatchPickerDialog"
                     x:DataType="vm:MatchPickerViewModel"
                     Title="{l:Tr MatchPickerTitle}"
                     PrimaryButtonText="{l:Tr MatchPickerUse}"
                     CloseButtonText="{l:Tr Cancel}"
                     DefaultButton="Primary"
                     IsPrimaryButtonEnabled="{Binding CanApply}">

    <!-- Stessi campi di Renamr.App/Views/MatchPickerDialog.xaml. -->
    <ctl:FAContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">720</x:Double>
    </ctl:FAContentDialog.Resources>

    <ctl:FAContentDialog.Styles>
        <Style Selector="TextBlock.hint">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style Selector="TextBlock.label">
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
    </ctl:FAContentDialog.Styles>

    <StackPanel Spacing="12" Width="600">
        <!-- Il file di cui si sceglie la corrispondenza -->
        <TextBlock Classes="hint" Text="{Binding FileName}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding FileName}" />

        <!-- Risultati già trovati (anche quelli scartati perché incerti) o della ricerca qui sotto -->
        <TextBlock Text="{l:Tr MatchPickerResults}" FontWeight="SemiBold" />
        <ListBox x:Name="ChoiceList" Height="260"
                 ItemsSource="{Binding Choices}"
                 SelectedItem="{Binding SelectedChoice}"
                 Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                 BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                 BorderThickness="1" CornerRadius="8" Padding="0,4">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:MatchChoiceViewModel">
                    <StackPanel Margin="4,4" Spacing="1" Background="Transparent" ToolTip.Tip="{Binding Overview}">
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Subtitle}" IsVisible="{Binding HasSubtitle}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Classes="hint" Text="{Binding Details}" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
            <ctl:FAProgressRing Width="16" Height="16" IsIndeterminate="True" IsVisible="{Binding IsSearching}" />
            <TextBlock Grid.Column="1" Classes="hint" Text="{Binding Message}" />
        </Grid>

        <!-- Ricerca personalizzata: titolo, anno, tipo e, per le serie, stagione ed episodio -->
        <TextBlock Text="{l:Tr MatchPickerSearchTitle}" FontWeight="SemiBold" Margin="0,4,0,0" />
        <Grid ColumnDefinitions="*,80,Auto" ColumnSpacing="8">
            <StackPanel>
                <TextBlock Classes="label" Text="{l:Tr MatchPickerQuery}" />
                <TextBox x:Name="QueryBox" Text="{Binding Query}" />
            </StackPanel>
            <StackPanel Grid.Column="1">
                <TextBlock Classes="label" Text="{l:Tr MatchPickerYear}" />
                <TextBox Text="{Binding Year}" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Classes="label" Text="{l:Tr MatchPickerKind}" />
                <ComboBox MinWidth="170" ItemsSource="{Binding Kinds}" SelectedIndex="{Binding KindIndex}" />
            </StackPanel>
        </Grid>
        <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="8">
            <StackPanel IsVisible="{Binding IsSeries}">
                <TextBlock Classes="label" Text="{l:Tr MatchPickerSeason}" />
                <TextBox Width="80" Text="{Binding Season}" />
            </StackPanel>
            <StackPanel Grid.Column="1" IsVisible="{Binding IsSeries}">
                <TextBlock Classes="label" Text="{l:Tr MatchPickerEpisode}" />
                <TextBox Width="80" Text="{Binding Episode}" />
            </StackPanel>
            <Button Grid.Column="3" VerticalAlignment="Bottom" Classes="accent" Command="{Binding SearchCommand}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <ctl:FASymbolIcon Symbol="Find" FontSize="14" />
                    <TextBlock Text="{l:Tr MatchPickerSearch}" />
                </StackPanel>
            </Button>
        </Grid>
    </StackPanel>
</ctl:FAContentDialog>
