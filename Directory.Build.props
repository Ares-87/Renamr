<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <!-- CA1822: i servizi sono istanze iniettate via DI; CA1848/CA1873: LoggerMessage non necessario qui. -->
    <NoWarn>$(NoWarn);CA1822;CA1848;CA1873</NoWarn>
    <!-- Versione mostrata nella barra del titolo ("Renamr v1.7.0"): si aumenta a ogni pull request. -->
    <Version>1.15.0</Version>
    <Company>Renamr</Company>
    <Product>Renamr</Product>
    <Copyright>Copyright (c) 2026 Daniele (Ares-87)</Copyright>
    <!-- Licenza: PolyForm Noncommercial 1.0.0 (vedi LICENSE). -->
    <PackageLicenseExpression>PolyForm-Noncommercial-1.0.0</PackageLicenseExpression>
  </PropertyGroup>
</Project>
